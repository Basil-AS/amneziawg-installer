# Reference: put the web panel behind an nginx "decoy + secret gate".
# Replace panel.example.org, the certificate paths and TOKEN (openssl rand -hex 16).
# Without the cookie every visitor sees a plain static site; with it the request is proxied to the
# panel, which still requires its own token login. All gate hits are logged with ip and user agent.
#
# http{} level (nginx.conf):
#   log_format gate_log '$time_iso8601 $remote_addr $status "$http_user_agent"';

map "$cookie___awg_adm" $is_admin {
    default 0;
    "~^TOKEN$" 1;
}

server {
    server_name panel.example.org;
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    ssl_certificate     /etc/letsencrypt/live/panel.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/panel.example.org/privkey.pem;

    # the panel listens on loopback HTTPS only (AWG_WEB_BIND=127.0.0.1, bind mode public_nginx)
    proxy_ssl_verify off;
    proxy_ssl_server_name on;
    proxy_ssl_name panel.example.org;

    # 1) the secret URL sets a short-lived cookie
    location ~* ^/hub-mgr-TOKEN/?$ {
        access_log /var/log/nginx/gate.log gate_log;
        add_header Set-Cookie "__awg_adm=TOKEN; Path=/; HttpOnly; SameSite=Strict; Secure; Max-Age=43200" always;
        return 302 /;
    }
    location ~* ^/hub-mgr-logout/?$ {
        add_header Set-Cookie "__awg_adm=; Path=/; HttpOnly; SameSite=Strict; Secure; Max-Age=0" always;
        return 302 /;
    }
    # 2) any other /hub-mgr* path is a guess: plain 404, logged, banned by fail2ban after a few tries
    location ~* ^/hub-mgr {
        access_log /var/log/nginx/gate.log gate_log;
        return 404;
    }

    # 3) API only with the cookie; everything else is the decoy
    location /api/ {
        if ($is_admin != 1) { return 404; }
        proxy_pass https://127.0.0.1:9443;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location / {
        if ($is_admin = 1) { proxy_pass https://127.0.0.1:9443; break; }
        root /var/www/decoy;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
